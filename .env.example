# Relay Agent Chat — host daemon config
# Port the daemon listens on (bind to localhost + expose via Tailscale Serve)
PORT=8787
HOST=127.0.0.1
# Data dir: projects registry, threads, messages, job logs
DATA_DIR=./data
# Auth token. Empty = auto-generate on first boot and store in DATA_DIR/.token
RELAY_TOKEN=
# Where project checkouts live (created on demand)
PROJECTS_ROOT=./projects
