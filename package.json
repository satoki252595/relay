{
  "name": "relay-agent-chat",
  "version": "0.1.0",
  "description": "Agent Chat Client — chat UI in front, official subscription CLIs behind",
  "type": "module",
  "main": "mac/main.js",
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test",
    "icons:pwa": "node ops/make-icons.mjs",
