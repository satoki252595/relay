{
  "appId": "dev.relay.agentchat.mac",
  "productName": "Relay",
  "copyright": "Copyright © 2026 satoki okamoto",
  "files": ["mac/**/*", "public/**/*", "server/**/*", "package.json"],
  "directories": { "output": "dist" },
  "asar": true,
  "npmRebuild": false,
  "mac": {
    "icon": "mac/icon.icns",
    "target": ["dmg", "zip"],
    "category": "public.app-category.developer-tools",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "mac/entitlements.mac.plist",
    "entitlementsInherit": "mac/entitlements.mac.plist"
  },
  "dmg": {
    "title": "Relay ${version}"
  },
  "afterSign": "mac/notarize.js"
}
